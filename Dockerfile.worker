# Use libs/eyvan as the build context. Every image argument is copied
# verbatim from oci/release-lock.json after validate-policy succeeds.
# Standalone: docker buildx build -f Dockerfile.worker [required build args] .
# Workspace:  docker buildx build -f libs/eyvan/Dockerfile.worker [required build args] libs/eyvan
ARG TARGETPLATFORM
ARG EYVAN_UV_IMAGE
ARG EYVAN_WORKER_BASE_IMAGE

FROM --platform=$TARGETPLATFORM ${EYVAN_UV_IMAGE} AS uv

FROM --platform=$TARGETPLATFORM ${EYVAN_WORKER_BASE_IMAGE} AS runtime
ARG TARGETPLATFORM
ARG TARGETOS
ARG TARGETARCH
ARG EYVAN_SOURCE
ARG EYVAN_REVISION
ARG EYVAN_VERSION
RUN test "$TARGETOS" = linux && test "$TARGETARCH" = amd64 && \
    test "$TARGETPLATFORM" = linux/amd64 && \
    printf '%s' "$EYVAN_REVISION" | grep -Eq '^[0-9a-f]{40}$' && \
    printf '%s' "$EYVAN_SOURCE" | grep -Eq '^https://github\.com/[^/]+/[^/]+$' && \
    printf '%s' "$EYVAN_VERSION" | grep -Eq '^[0-9]+([.][0-9A-Za-z]+)+([-+][0-9A-Za-z.-]+)?$'
LABEL org.opencontainers.image.source="${EYVAN_SOURCE}" \
      org.opencontainers.image.revision="${EYVAN_REVISION}" \
      org.opencontainers.image.version="${EYVAN_VERSION}" \
      org.opencontainers.image.title="Eyvan native Kubernetes worker" \
      org.opencontainers.image.description="Native execution worker for Eyvan Kubernetes capacity cells" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later"
COPY --from=uv /uv /uvx /bin/
ENV VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    EYVAN_NATIVE_WORKER_STATE_DIR=/var/lib/eyvan/native-worker
WORKDIR /app
COPY requirements-docker.txt ./requirements-docker.txt
RUN uv venv "$VIRTUAL_ENV" && \
    uv pip install --require-hashes -r requirements-docker.txt
COPY pyproject.toml README.md LICENSE ./src/
COPY eyvan ./src/eyvan
RUN uv pip install --no-deps ./src && \
    rm -rf ./src && \
    install -d -o 65532 -g 65532 -m 0700 /var/lib/eyvan/native-worker
USER 65532:65532
EXPOSE 8100
ENTRYPOINT ["eyvan-native-worker"]
CMD ["--host", "0.0.0.0", "--port", "8100", "--state-dir", "/var/lib/eyvan/native-worker", "--secret-file", "/var/run/eyvan/token"]
